{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/upstream-guard.sh\"", "timeout": 10, "statusMessage": "Checking upstream guard" }]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/upstream-guard.sh\"", "timeout": 10 }]
      }
    ]
  }
}
